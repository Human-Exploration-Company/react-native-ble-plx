{
  "name": "ble-plx-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "bunx --bun @expo/agent-cli start --dev-client",
    "android": "bunx --bun @expo/agent-cli dev --android",
    "ios": "bunx --bun @expo/agent-cli dev --ios",
    "prebuild": "bunx --bun @expo/agent-cli prebuild --no-install",
    "doctor": "bunx --bun @expo/agent-cli doctor",
    "export:native": "bunx --bun @expo/agent-cli export --platform ios --platform android --output-dir ../dist/native"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-dev-client": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "workspace:*"
  }
}
