{
  "name": "react-native-ble-plx",
  "version": "4.0.0-alpha.1",
  "description": "An Expo Modules 2.0 Bluetooth LE client with typed sessions and binary values",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "MIGRATION.md",
    "RELEASE.md",
    "docs/VALIDATION.md",
    "src",
    "android/src",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "ios",
    "expo-module.config.json",
    "app.plugin.ts",
    "app.plugin.js"
  ],
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.4.4-canary.20261025.1",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "bun check",
    "lint": "bun lint --no-script --deny-warnings",
    "format": "bun fmt",
    "test": "bun test",
    "verify": "bun check && bun run lint && bun fmt --check && bun test && bun run build --check",
    "start": "bun run --cwd example start",
    "android": "bun run --cwd example android",
    "ios": "bun run --cwd example ios",
    "doctor": "bun run --cwd example doctor",
    "export:native": "bun run --cwd example export:native",
    "read:search-expo-docs": "bunx --bun @expo/agent-cli docs:search --limit 5 --json --no-followups",
    "agents:setup": "bunx --bun @expo/agent-cli agents:setup --yes --project --agent codex --no-agents-md",
    "agents:sync": "bunx --bun @expo/agent-cli skills:sync --agent codex --agent claude-code && bunx --bun @expo/agent-cli docs:sync"
  },
  "dependencies": {
    "@expo/config-plugins": "~58.0.10"
  },
  "peerDependencies": {
    "expo": "^58.0.19",
    "react": "^19.3.0",
    "react-native": "^0.88.0"
  },
  "devDependencies": {
    "@expo/agent-cli": "1.0.20",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "expo": "~58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "repository": "https://github.com/Human-Exploration-Company/react-native-ble-plx.git",
  "homepage": "https://github.com/Human-Exploration-Company/react-native-ble-plx#readme",
  "bugs": {
    "url": "https://github.com/Human-Exploration-Company/react-native-ble-plx/issues"
  },
  "author": "Human Exploration Company; original BLE adapters by Polidea and dotintent",
  "license": "Apache-2.0",
  "patchedDependencies": {
    "@expo/require-utils@58.0.4": "patches/@expo%2Frequire-utils@58.0.4.patch"
  }
}
